FROM nvidia/cuda:12.1.1-base-ubuntu22.04

# Set working directory
WORKDIR /app

ENV DEBIAN_FRONTEND=noninteractive

# Install system dependencies
RUN apt update && apt install -y software-properties-common

RUN add-apt-repository -y ppa:deadsnakes/ppa
RUN add-apt-repository -y ppa:ubuntugis/ppa

RUN apt-get update && \
    apt-get install -y gcc g++ wget git && \
    apt-get install -y gdal-bin libgdal-dev && \
    apt-get install -y ffmpeg libsm6 libxext6 libgl1 && \
    apt-get install -y python3.11 python3-pip python3.11-venv python3.11-dev && \
    apt-get install -y cmake ninja-build sqlite3 && \
    apt-get install -y swig4.0 python3-setuptools && \
    ln -sf /usr/bin/swig4.0 /usr/bin/swig && \
    apt-get clean && \
    rm -rf /var/lib/apt/lists/*

RUN update-alternatives --install /usr/bin/python3 python /usr/bin/python3.11 2
RUN update-alternatives --install /usr/bin/python3 python /usr/bin/python3.10 1
RUN update-alternatives --set python /usr/bin/python3.11

RUN python3.11 -m ensurepip --upgrade

# Upgrade pip and install uv
RUN python3.11 -m pip install --upgrade pip
RUN python3.11 -m pip install uv

# Install compatible setuptools for GDAL build
RUN python3.11 -m pip install "setuptools<66" wheel

# Install NumPy with better compatibility
RUN python3.11 -m pip install --no-cache-dir --force-reinstall --no-deps numpy && \
    python3.11 -c "import numpy; print('NumPy working:', numpy.__version__)" || \
    echo "NumPy test failed, will build GDAL without NumPy"

# Force baseline x86-64 ISA for all compilations (including cmake checks).
# Prevents QEMU "Illegal instruction" crashes when cross-compiling linux/amd64
# on ARM hosts — QEMU can't emulate SSE4.2/AVX instructions that -O3 may emit.
ENV CFLAGS="-march=x86-64" CXXFLAGS="-march=x86-64"

# PROJ build: -j1 + retry for QEMU resilience
RUN cd /tmp && \
    wget https://download.osgeo.org/proj/proj-9.3.0.tar.gz && \
    tar -xzf proj-9.3.0.tar.gz && \
    cd proj-9.3.0 && \
    mkdir build && \
    cd build && \
    cmake .. \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DBUILD_SHARED_LIBS=ON \
        -DENABLE_TIFF=OFF \
        -DENABLE_CURL=OFF \
        -DBUILD_TESTING=OFF \
        -DBUILD_APPS=OFF && \
    proj_ok=0 && \
    for attempt in 1 2 3; do \
        echo "PROJ build attempt $attempt..." && \
        make -j1 VERBOSE=1 && proj_ok=1 && break; \
        echo "PROJ build failed (attempt $attempt), retrying..."; \
    done && \
    test "$proj_ok" = "1" && \
    make install && \
    cd /tmp && \
    rm -rf proj-9.3.0*

# Install GDAL from source with Python bindings
RUN wget https://download.osgeo.org/gdal/3.11.3/gdal-3.11.3.tar.gz && \
    tar zxvf gdal-3.11.3.tar.gz && \
    mkdir -p gdal-3.11.3/build && \
    cd gdal-3.11.3/build

# Debug environment before building
RUN cd gdal-3.11.3/build && \
    echo "=== Environment Check ===" && \
    which python3.11 && \
    python3.11 --version && \
    which swig && \
    swig -version && \
    echo "=== CMake Configure (without NumPy to avoid compatibility issues) ===" && \
    GDAL_PYTHON_BINDINGS_WITHOUT_NUMPY=1 cmake .. -G Ninja \
        -DCMAKE_BUILD_TYPE=Release \
        -DCMAKE_INSTALL_PREFIX=/usr/local \
        -DBUILD_SHARED_LIBS=ON \
        -DBUILD_PYTHON_BINDINGS=ON \
        -DPython_LOOKUP_VERSION=3.11 \
        -DSWIG_EXECUTABLE=/usr/bin/swig

# Build GDAL: --parallel 1 + retry to work around QEMU "Illegal instruction" crashes.
# Use bash -o pipefail so build failures aren't masked by the tee pipe.
RUN cd gdal-3.11.3/build && \
    echo "=== Starting GDAL Build ===" && \
    gdal_ok=0 && \
    for attempt in 1 2 3; do \
        echo "GDAL build attempt $attempt..." && \
        bash -c 'set -o pipefail; cmake --build ./ --parallel 1 2>&1 | tee build.log' && gdal_ok=1 && break; \
        echo "=== BUILD FAILED (attempt $attempt) - Last 50 lines ===" && tail -50 build.log; \
    done && \
    test "$gdal_ok" = "1"

# Install
RUN cd gdal-3.11.3/build && \
    echo "=== Installing GDAL ===" && \
    cmake --install ./ && \
    cd ../.. && \
    rm -rf gdal-3.11.3*

# Set environment variables
ENV GDAL_DATA=/usr/local/share/gdal
ENV LD_LIBRARY_PATH=/usr/local/lib:$LD_LIBRARY_PATH
ENV PATH=/usr/local/bin:$PATH
ENV PYTHONPATH=/usr/local/lib/python3.11/site-packages:$PYTHONPATH

# Ensure NumPy is working after GDAL build
RUN python3.11 -m pip install --no-cache-dir --force-reinstall numpy --root-user-action=ignore

WORKDIR /app

# Copy requirements and install Python dependencies
COPY shared/requirements.txt /app/

RUN uv pip install -r /app/requirements.txt --system
