# =============================================================================
# Pipeline base image: adds Python requirements on top of the static base
#
# The static base (Dockerfile.base-static) has CUDA, PROJ, GDAL, and NumPy
# pre-compiled. This layer only installs the shared Python requirements,
# so it rebuilds in ~2-3 minutes instead of ~42 minutes.
# =============================================================================
ARG STATIC_BASE_IMAGE
FROM ${STATIC_BASE_IMAGE}

WORKDIR /app

# Install shared Python requirements
COPY shared/requirements.txt /app/requirements.txt
RUN uv pip install -r /app/requirements.txt --system

# Verify key dependencies work
RUN python3.11 -c "from osgeo import gdal; print('GDAL:', gdal.__version__)" && \
    python3.11 -c "import numpy; print('NumPy:', numpy.__version__)" && \
    python3.11 -c "import rasterio; print('Rasterio:', rasterio.__version__)" && \
    gdal-config --version

# Bake shared library code used by floods, burn_scars, crop_classification
RUN mkdir -p /app/lib
COPY shared/lib /app/lib
COPY shared/predictor.py /app/
